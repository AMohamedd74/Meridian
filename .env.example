# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase (public: safe in the browser; data is protected by Row Level Security) ---
# Dashboard → Project Settings → API. Never put the service-role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- AI (server-only secrets: never prefix with NEXT_PUBLIC_) ---
# "openai" or "mock". Defaults to openai when OPENAI_API_KEY is set, otherwise mock.
# The mock provider is refused in production.
AI_PROVIDER=openai
OPENAI_API_KEY=
# Optional overrides.
OPENAI_MODEL=gpt-5.6-terra
# OPENAI_REASONING_EFFORT=low
# OPENAI_CONVERSATION_TIMEOUT_MS=30000
# OPENAI_GENERATION_TIMEOUT_MS=90000

# --- Mock AI (local development / tests only) ---
# Simulated latency for mock AI calls (ms), so loading states are visible.
MOCK_AI_LATENCY_MS=900
# 0..1 — probability a mock AI call fails. Use to exercise error states.
MOCK_AI_FAILURE_RATE=0

# --- Error monitoring (optional; without a DSN, Sentry is inert) ---
# Server errors. Browser errors need the NEXT_PUBLIC_ one (a DSN is write-only, safe to expose).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Only needed to upload source maps at build time (readable stack traces).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# Performance tracing sample rate, 0..1. Errors are always sent; tracing costs quota.
# SENTRY_TRACES_SAMPLE_RATE=0
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
